datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

model Store {
  id            String   @id
  posCode       String   @unique @map("pos_code")
  storeName     String   @map("store_name")
  storeType     String   @default("Retail") @map("store_type")
  category      String   @default("Retail")
  locationType  String   @default("iPlanet Retail Store") @map("location_type")
  brand         String   @default("iPlanet")
  address       String
  area          String?
  locality      String?
  city          String
  state         String
  country       String   @default("India")
  pincode       String
  landmark      String?
  latitude      Float?
  longitude     Float?
  phone         String?
  contactPerson String?  @map("contact_person")
  storeManager  String?  @map("store_manager")
  openingTime   String?  @default("10:00 AM") @map("opening_time")
  closingTime   String?  @default("09:30 PM") @map("closing_time")
  workingDays   String?  @default("Monday to Sunday") @map("working_days")
  googlePlaceId String?  @map("google_place_id")
  googleMapsUrl String?  @map("google_maps_url")
  status        String   @default("Active")
  priority      Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  stock          StoreStock[]
  stockMovements StockMovement[]

  @@index([category])
  @@index([status])
  @@index([city])
  @@index([pincode])
  @@index([locationType])
  @@map("stores")
}

model Product {
  id        String   @id @default(cuid())
  sku       String   @unique
  name      String
  category  String
  segment   String?
  class     String?
  variant   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stock     StoreStock[]
  movements StockMovement[]

  @@index([category])
  @@index([segment])
  @@index([class])
  @@map("products")
}

model StoreStock {
  id                String   @id @default(cuid())
  storeId           String   @map("store_id")
  productId         String   @map("product_id")
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(2) @map("low_stock_threshold")
  updatedAt         DateTime @updatedAt @map("updated_at")
  updatedBy         String?  @map("updated_by")

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
  @@index([productId])
  @@map("store_stock")
}

model StockMovement {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  productId String   @map("product_id")
  delta     Int
  newQty    Int      @map("new_qty")
  reason    String
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  user      String?

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@map("stock_movements")
}

/// A customer enquiry passed to a store through the "Pass to Store" form.
/// Store name and POS code are kept as a snapshot so history survives store edits or deletion.
model Lead {
  id             String   @id @default(cuid())
  /// Generated in the browser per form content, so a double-click can't record the same lead twice.
  clientId       String   @unique @map("client_id")
  customerName   String   @map("customer_name")
  /// 10 digits, no country code.
  customerMobile String   @map("customer_mobile")
  storeName      String   @map("store_name")
  posCode        String   @map("pos_code")
  product        String
  remarks        String?
  /// Which WhatsApp the CEC opened: "web" or "desktop".
  channel        String   @default("web")
  createdAt      DateTime @default(now()) @map("created_at")
  /// Who passed the lead. Null for leads recorded before individual logins existed.
  userId         String?  @map("user_id")
  /// The person's name at the time, kept so history still reads correctly if they are renamed.
  userName       String?  @map("user_name")
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([posCode])
  @@index([userId, createdAt])
  @@map("leads")
}

/// A person who can sign in. Role is "ADMIN" (everything) or "SALES" (store finder, stock and
/// product viewing, and their own lead history).
model User {
  id           String    @id @default(cuid())
  /// Lowercase sign-in name.
  username     String    @unique
  name         String
  role         String    @default("SALES")
  passwordHash String    @map("password_hash")
  active       Boolean   @default(true)
  /// Bumped on role, status or password changes so existing sessions stop working.
  tokenVersion Int       @default(0) @map("token_version")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  leads Lead[]

  @@map("users")
}
