datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

model Store {
  id            String   @id
  posCode       String   @unique @map("pos_code")
  storeName     String   @map("store_name")
  storeType     String   @default("Retail") @map("store_type")
  category      String   @default("Retail")
  locationType  String   @default("iPlanet Retail Store") @map("location_type")
  brand         String   @default("iPlanet")
  address       String
  area          String?
  locality      String?
  city          String
  state         String
  country       String   @default("India")
  pincode       String
  landmark      String?
  latitude      Float?
  longitude     Float?
  phone         String?
  contactPerson String?  @map("contact_person")
  storeManager  String?  @map("store_manager")
  openingTime   String?  @default("10:00 AM") @map("opening_time")
  closingTime   String?  @default("09:30 PM") @map("closing_time")
  workingDays   String?  @default("Monday to Sunday") @map("working_days")
  googlePlaceId String?  @map("google_place_id")
  googleMapsUrl String?  @map("google_maps_url")
  status        String   @default("Active")
  priority      Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  stock          StoreStock[]
  stockMovements StockMovement[]

  @@index([category])
  @@index([status])
  @@index([city])
  @@index([pincode])
  @@index([locationType])
  @@map("stores")
}

model Product {
  id        String   @id @default(cuid())
  sku       String   @unique
  name      String
  category  String
  variant   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stock     StoreStock[]
  movements StockMovement[]

  @@index([category])
  @@map("products")
}

model StoreStock {
  id                String   @id @default(cuid())
  storeId           String   @map("store_id")
  productId         String   @map("product_id")
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(2) @map("low_stock_threshold")
  updatedAt         DateTime @updatedAt @map("updated_at")
  updatedBy         String?  @map("updated_by")

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
  @@index([productId])
  @@map("store_stock")
}

model StockMovement {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  productId String   @map("product_id")
  delta     Int
  newQty    Int      @map("new_qty")
  reason    String
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  user      String?

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@map("stock_movements")
}
