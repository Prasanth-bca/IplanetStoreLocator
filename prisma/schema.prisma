datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

model Store {
  id            String   @id
  posCode       String   @unique @map("pos_code")
  storeName     String   @map("store_name")
  storeType     String   @default("Retail") @map("store_type")
  category      String   @default("Retail")
  locationType  String   @default("iPlanet Retail Store") @map("location_type")
  brand         String   @default("iPlanet")
  address       String
  area          String?
  locality      String?
  city          String
  state         String
  country       String   @default("India")
  pincode       String
  landmark      String?
  latitude      Float?
  longitude     Float?
  phone         String?
  contactPerson String?  @map("contact_person")
  storeManager  String?  @map("store_manager")
  openingTime   String?  @default("10:00 AM") @map("opening_time")
  closingTime   String?  @default("09:30 PM") @map("closing_time")
  workingDays   String?  @default("Monday to Sunday") @map("working_days")
  googlePlaceId String?  @map("google_place_id")
  googleMapsUrl String?  @map("google_maps_url")
  status        String   @default("Active")
  priority      Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  stock          StoreStock[]
  stockMovements StockMovement[]

  @@index([category])
  @@index([status])
  @@index([city])
  @@index([pincode])
  @@index([locationType])
  @@map("stores")
}

model Product {
  id        String   @id @default(cuid())
  sku       String   @unique
  name      String
  category  String
  segment   String?
  class     String?
  variant   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stock     StoreStock[]
  movements StockMovement[]

  @@index([category])
  @@index([segment])
  @@index([class])
  @@map("products")
}

model StoreStock {
  id                String   @id @default(cuid())
  storeId           String   @map("store_id")
  productId         String   @map("product_id")
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(2) @map("low_stock_threshold")
  updatedAt         DateTime @updatedAt @map("updated_at")
  updatedBy         String?  @map("updated_by")

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
  @@index([productId])
  @@map("store_stock")
}

model StockMovement {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  productId String   @map("product_id")
  delta     Int
  newQty    Int      @map("new_qty")
  reason    String
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  user      String?

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@map("stock_movements")
}

/// A customer enquiry passed to a store through the "Pass to Store" form.
/// Store name and POS code are kept as a snapshot so history survives store edits or deletion.
model Lead {
  id             String   @id @default(cuid())
  /// Generated in the browser per form content, so a double-click can't record the same lead twice.
  clientId       String   @unique @map("client_id")
  customerName   String   @map("customer_name")
  /// 10 digits, no country code.
  customerMobile String   @map("customer_mobile")
  storeName      String   @map("store_name")
  posCode        String   @map("pos_code")
  product        String
  remarks        String?
  /// Which WhatsApp the CEC opened: "web" or "desktop".
  channel        String   @default("web")
  createdAt      DateTime @default(now()) @map("created_at")
  /// Who passed the lead. Null for leads recorded before individual logins existed.
  userId         String?  @map("user_id")
  /// The person's name at the time, kept so history still reads correctly if they are renamed.
  userName       String?  @map("user_name")
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([posCode])
  @@index([userId, createdAt])
  @@map("leads")
}

/// A person who can sign in. Role is "ADMIN" (everything) or "SALES" (store finder, stock and
/// product viewing, and their own lead history).
model User {
  id           String    @id @default(cuid())
  /// Lowercase sign-in name.
  username     String    @unique
  name         String
  role         String    @default("SALES")
  passwordHash String    @map("password_hash")
  active       Boolean   @default(true)
  /// Bumped on role, status or password changes so existing sessions stop working.
  tokenVersion Int       @default(0) @map("token_version")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  leads        Lead[]
  sessions     UserSession[]
  billingNotes BillingNote[]
  storeAccount StoreAccount?
  sharedLeads  StoreLead[]

  @@map("users")
}

/// Historical and real-time login sessions and live monitoring activity.
model UserSession {
  id           String    @id @default(cuid())
  userId       String?   @map("user_id")
  username     String
  name         String?
  role         String?
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  deviceType   String?   @map("device_type")
  browser      String?
  os           String?
  currentPath  String?   @default("/") @map("current_path")
  status       String    @default("ACTIVE")
  loginAt      DateTime  @default(now()) @map("login_at")
  lastActiveAt DateTime  @default(now()) @map("last_active_at")
  endedAt      DateTime? @map("ended_at")
  failReason   String?   @map("fail_reason")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loginAt])
  @@index([lastActiveAt])
  @@index([status])
  @@map("user_sessions")
}

/// A promotional campaign window (e.g. Diwali). Controls the festive label and styling of the two
/// offer panels. The offers themselves carry their own validity dates.
model OfferCampaign {
  id        String   @id @default(cuid())
  name      String
  /// Shown on both offer panels while the campaign is running, e.g. "DIWALI SPECIAL".
  label     String   @default("")
  /// "Diwali" turns on the festive styling; "None" shows only the label.
  theme     String   @default("None")
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  active    Boolean  @default(true)

  @@map("offer_campaigns")
}

/// Store discount offers, imported from the Offers Master workbook ("Store Offers" sheet).
model StoreOffer {
  id            String    @id @default(cuid())
  /// The Offer ID from the workbook.
  offerId       String    @unique @map("offer_id")
  category      String
  /// Model family as in the offer sheet; matched to the catalogue Class ignoring case/spaces/symbols.
  productName   String    @map("product_name")
  variant       String?
  storage       String?
  /// The source sheet's own heading, e.g. "Unconditional Flat Off", "Corporate", "Special Offer 1".
  offerType     String    @map("offer_type")
  /// "Without Cashify" / "With Cashify" where the source separates them.
  tradeIn       String?   @map("trade_in")
  customer      String
  /// "Percent", "Amount (₹)" or "Benefit (text)".
  discountType  String    @map("discount_type")
  discountValue Float?    @map("discount_value")
  isUpTo        Boolean?  @map("is_up_to")
  offerText     String    @map("offer_text")
  eligibility   String?
  combinable    Boolean   @default(true)
  /// India calendar dates, both inclusive. A null validUntil means no end date.
  validFrom     DateTime? @map("valid_from") @db.Date
  validUntil    DateTime? @map("valid_until") @db.Date
  terms         String?
  status        String    @default("Active")
  source        String?
  sortOrder     Int       @default(0) @map("sort_order")

  @@index([category])
  @@index([productName])
  @@map("store_offers")
}

/// Bank / partner offers, imported from the "Bank Offers" sheet. A workbook row naming several banks
/// becomes one row per bank so the panel can filter by bank.
model BankOffer {
  id          String    @id @default(cuid())
  offerId     String    @map("offer_id")
  bank        String
  category    String
  productName String    @map("product_name")
  variant     String?
  /// "Exact" or "Contains all": how matchText is tested against the catalogue Class / Name.
  matchType   String    @map("match_type")
  matchText   String    @map("match_text")
  cardType    String?   @map("card_type")
  offerType   String    @map("offer_type")
  amount      Int?
  percent     Float?
  minTxn      Int?      @map("min_txn")
  maxCashback Int?      @map("max_cashback")
  emiType     String    @map("emi_type")
  details     String?
  rvFrom      Int?      @map("rv_from")
  rvTo        Int?      @map("rv_to")
  combinable  Boolean   @default(true)
  validFrom   DateTime? @map("valid_from") @db.Date
  validUntil  DateTime? @map("valid_until") @db.Date
  terms       String?
  status      String    @default("Active")
  source      String?
  sortOrder   Int       @default(0) @map("sort_order")

  @@unique([offerId, bank])
  @@index([category])
  @@map("bank_offers")
}

/// One row per successful import, so the panels can show when the data was last refreshed.
model OfferImport {
  id             String   @id @default(cuid())
  fileName       String   @map("file_name")
  importedAt     DateTime @default(now()) @map("imported_at")
  importedById   String?  @map("imported_by_id")
  importedByName String?  @map("imported_by_name")
  storeCount     Int      @map("store_count")
  bankCount      Int      @map("bank_count")
  campaignCount  Int      @map("campaign_count")
  /// Non-blocking warnings from the import, as JSON text.
  warnings       String?

  @@index([importedAt])
  @@map("offer_imports")
}

/// The chatbot's settings: one row (id "default"). The Groq API key is stored encrypted and never sent to a browser.
model ChatSetting {
  id            String   @id @default("default")
  enabled       Boolean  @default(false)
  /// AES-256-GCM encrypted Groq key ("iv.tag.cipher", base64url); null until an admin saves one.
  apiKeyEnc     String?  @map("api_key_enc")
  /// Last 4 characters of the key, so the admin screen can show which key is saved.
  apiKeyHint    String?  @map("api_key_hint")
  /// What staff see in the chat window and what the assistant calls itself.
  assistantName String   @default("Assistant") @map("assistant_name")
  model         String   @default("llama-3.3-70b-versatile")
  systemPrompt  String   @default("") @map("system_prompt")
  temperature   Float    @default(0.6)
  maxTokens     Int      @default(800) @map("max_tokens")
  /// Messages one person may send per minute.
  ratePerMinute Int      @default(12) @map("rate_per_minute")
  updatedAt     DateTime @updatedAt @map("updated_at")
  updatedByName String?  @map("updated_by_name")

  @@map("chat_settings")
}

/// A note made by a sales representative about a customer who was billed on a DIFFERENT phone number from the one
/// they spoke to and dialled (so the billing team can match the sale to the call).
/// Rows stay if the person's account is deleted: the agent name is kept as a snapshot.
model BillingNote {
  id            String   @id @default(cuid())
  /// The calendar day of the call / sale (India date).
  bookingDate   DateTime @map("booking_date") @db.Date
  /// 10-digit mobile the invoice was raised on. Every field is optional except the date, which defaults to today.
  billedPhone   String?  @map("billed_phone")
  /// 10-digit mobile the representative spoke to and dialled.
  dialledPhone  String?  @map("dialled_phone")
  customerName  String?  @map("customer_name")
  /// Free text as typed in the sheet, e.g. "M5 Air", "17 Pro", "Airpods 5".
  model         String?
  /// Store POS code, e.g. "TAM".
  location      String?
  /// "NOTED", "NOT_BILLED" or "BILLED".
  status        String   @default("NOTED")
  invoice       String?
  /// Invoice value in rupees.
  value         Int?
  remarks       String?
  /// The agent's own code from the calling system, as written in the sheet (e.g. "106936" or "Doocti").
  agentCode     String?  @map("agent_code")
  agentName     String   @map("agent_name")
  createdById   String?  @map("created_by_id")
  createdBy     User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  updatedByName String?  @map("updated_by_name")

  @@index([bookingDate])
  @@index([billedPhone])
  @@index([dialledPhone])
  @@index([createdById, bookingDate])
  @@map("billing_notes")
}

/// Ties one store login (a User with role STORE) to one store. Kept in its own table so the users table is not changed.
model StoreAccount {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  /// The store's POS code (stores.pos_code). Kept as text so the account survives a store being edited.
  posCode   String   @unique @map("pos_code")
  storeName String   @map("store_name")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("store_accounts")
}

/// A customer lead a sales user shared directly with one store. The reminders count from `assignedAt`.
/// The sales user and the store are always kept on the row, even though the store does not see who shared it.
model StoreLead {
  id              String    @id @default(cuid())
  /// Generated in the browser per form, so a double-click cannot share the same lead twice.
  clientId        String    @unique @map("client_id")
  customerName    String    @map("customer_name")
  /// 10 digits, no country code.
  customerMobile  String    @map("customer_mobile")
  /// The device or product the customer wants.
  requirement     String
  /// What the sales user noted when sharing.
  remarks         String?
  posCode         String    @map("pos_code")
  storeName       String    @map("store_name")
  sharedById      String?   @map("shared_by_id")
  sharedByName    String    @map("shared_by_name")
  sharedBy        User?     @relation(fields: [sharedById], references: [id], onDelete: SetNull)
  /// The matching row in the existing lead history (leads.id), so the sales user's Lead History shows it too.
  leadId          String?   @map("lead_id")
  /// The moment the lead was assigned. Both reminders are measured from here.
  assignedAt      DateTime  @default(now()) @map("assigned_at")
  /// "COLD" | "WARM" | "HOT"
  interest        String?
  /// "TODAY" | "TOMORROW" | "LATER"
  visitIntention  String?   @map("visit_intention")
  visitUpdatedAt  DateTime? @map("visit_updated_at")
  /// "CLOSED" | "NOT_CLOSED" | "NOT_INTERESTED"; null until the store decides.
  conversion      String?
  /// When the store first did anything with the lead (a remark or any of the three choices). Stops the reminders.
  firstResponseAt DateTime? @map("first_response_at")
  lastActivityAt  DateTime  @default(now()) @map("last_activity_at")
  closedAt        DateTime? @map("closed_at")
  /// Required when conversion is CLOSED: who was actually billed.
  billedName      String?   @map("billed_name")
  billedMobile    String?   @map("billed_mobile")

  activities      LeadActivity[]
  notifications   LeadNotification[]

  @@index([posCode, assignedAt])
  @@index([sharedById, assignedAt])
  @@index([firstResponseAt, assignedAt])
  @@index([conversion])
  @@map("store_leads")
}

/// The follow-up history of a lead: every remark and status change, kept in full (never overwritten).
model LeadActivity {
  id          String    @id @default(cuid())
  storeLeadId String    @map("store_lead_id")
  at          DateTime  @default(now())
  byUserId    String?   @map("by_user_id")
  byName      String    @map("by_name")
  /// "ASSIGNED" | "FOLLOW_UP" | "CLOSED"
  kind        String
  note        String?
  interest    String?
  visitIntention String? @map("visit_intention")
  conversion  String?
  storeLead   StoreLead @relation(fields: [storeLeadId], references: [id], onDelete: Cascade)

  @@index([storeLeadId, at])
  @@map("lead_activities")
}

/// An automatic reminder for a store. One row per lead per interval, enforced by the unique key, so it can never repeat.
model LeadNotification {
  id          String    @id @default(cuid())
  storeLeadId String    @map("store_lead_id")
  posCode     String    @map("pos_code")
  /// "REMINDER_20" | "REMINDER_40"
  kind        String
  /// When the reminder fell due (assignedAt plus 20 or 40 minutes).
  dueAt       DateTime  @map("due_at")
  /// When the server actually created it.
  createdAt   DateTime  @default(now()) @map("created_at")
  readAt      DateTime? @map("read_at")
  readByName  String?   @map("read_by_name")
  storeLead   StoreLead @relation(fields: [storeLeadId], references: [id], onDelete: Cascade)

  @@unique([storeLeadId, kind])
  @@index([posCode, readAt])
  @@index([createdAt])
  @@map("lead_notifications")
}

/// Market Price & Offers: who may open the module (admin always can). One row, id "default".
model MarketSetting {
  id            String   @id @default("default")
  salesEnabled  Boolean  @default(true) @map("sales_enabled")
  storeEnabled  Boolean  @default(false) @map("store_enabled")
  updatedAt     DateTime @updatedAt @map("updated_at")
  updatedByName String?  @map("updated_by_name")

  @@map("market_settings")
}

/// One platform's current price for one exact product + variant (productKey). Never invented: every row has a source link,
/// a time, and who or what supplied it (MANUAL = an admin typed it from the retailer's page; otherwise a connected feed).
model MarketPrice {
  id            String        @id @default(cuid())
  productKey    String        @map("product_key")
  productLabel  String        @map("product_label")
  category      String
  platform      String
  retailerName  String?       @map("retailer_name")
  mrp           Int?
  sellingPrice  Int           @map("selling_price")
  availability  String        @default("UNKNOWN")
  sourceUrl     String        @map("source_url")
  sourceKind    String        @default("MANUAL") @map("source_kind")
  sourceName    String?       @map("source_name")
  enteredByName String?       @map("entered_by_name")
  fetchedAt     DateTime      @default(now()) @map("fetched_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  offers        MarketOffer[]

  @@unique([productKey, platform, retailerName])
  @@index([productKey])
  @@index([category])
  @@map("market_prices")
}

model MarketOffer {
  id             String      @id @default(cuid())
  priceId        String      @map("price_id")
  price          MarketPrice @relation(fields: [priceId], references: [id], onDelete: Cascade)
  kind           String
  title          String
  bank           String?
  discountAmount Int?        @map("discount_amount")
  discountPercent Float?     @map("discount_percent")
  minAmount      Int?        @map("min_amount")
  maxDiscount    Int?        @map("max_discount")
  validFrom      DateTime?   @map("valid_from")
  validUntil     DateTime?   @map("valid_until")
  variants       String?
  terms          String?
  link           String?

  @@index([priceId])
  @@map("market_offers")
}
