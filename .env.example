# ==============================================================================
# iPlanet AI Store Locator - Environment Configuration
# ==============================================================================

# Server Port
PORT=3000

# Database Configuration (PostgreSQL / Supabase / Neon / Local)
# When PostgreSQL is not provided, the application runs on resilient file-backed store master storage
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iplanet_locator?schema=public

# Google Maps Platform APIs (Server-Side)
# Geocoding API, Places API, Routes / Distance Matrix API
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=

# Public Frontend Google Maps Key (Optional - application provides embedded interactive maps with Leaflet fallback)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Admin Authentication Secret
ADMIN_PASSWORD=admin@iplanet2026
ADMIN_SESSION_SECRET=iplanet_super_secret_jwt_key_2026
